# Must point at the SAME Postgres database the Raxor bot uses.
DATABASE_URL=postgresql://user:password@localhost:5432/raxor

# Discord OAuth2 application (Developer Portal -> OAuth2)
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Must exactly match a redirect registered on the Discord application,
# AND end in /auth/discord/callback (not /auth/callback — that path is
# the frontend's own React Router route; see api/routes/auth.py's
# /discord/callback docstring for why they can't be the same path).
#   Local dev (frontend + backend as two separate servers):
#     http://localhost:8000/auth/discord/callback
#   Render (single combined Docker service, see ../Dockerfile):
#     https://<your-service>.onrender.com/auth/discord/callback
DISCORD_REDIRECT_URI=http://localhost:8000/auth/discord/callback

# Where to send the browser after login.
#   Local dev: http://localhost:5173 (the Vite dev server)
#   Render: https://<your-service>.onrender.com (same origin as the
#   backend, since the Dockerfile builds one combined service)
FRONTEND_URL=http://localhost:5173

# Comma-separated list of origins allowed to call this API. Only
# matters for the local two-service dev setup, where the frontend
# (localhost:5173) and backend (localhost:8000) are different origins.
# On Render's single combined service this is a no-op — everything is
# same-origin — but it's harmless to leave set.
CORS_ORIGINS=http://localhost:5173

# Long random string used to sign dashboard session tokens
JWT_SECRET_KEY=
# Short on purpose — the token only references a server-side session that
# re-verifies guild permissions on its own schedule (see core/security.py).
JWT_EXPIRE_MINUTES=60

# Required. Encrypts the Discord access/refresh tokens stored in the
# dashboard_sessions table at rest (see db/sessions.py). The app will not
# start without this set. Use a different random value than JWT_SECRET_KEY.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_ENCRYPTION_KEY=

# Same bot owner id as the bot's .env — only used to show a "Developer" badge
BOT_OWNER_ID=

# Optional: enables live channel/role selectors + username search by
# calling Raxor's own internal API (Raxor/web/internal.py) — NOT
# Discord's bot token, which the dashboard never holds. Point this at
# wherever the bot's health-check web server is reachable, and set
# DASHBOARD_INTERNAL_KEY to the exact same value as Raxor/.env's
# DASHBOARD_INTERNAL_KEY. Leave either blank and those features fall
# back to plain manual ID entry.
# NOTE: in production (ENVIRONMENT=production below), BOT_INTERNAL_API_URL
# must use https:// — a plain http:// internal/private-network URL that
# worked before will now fail startup validation.
BOT_INTERNAL_API_URL=http://localhost:8080
DASHBOARD_INTERNAL_KEY=

ENVIRONMENT=development
# Set this to "production" on Render (or any real deployment) — it
# makes the OAuth `state` cookie (see api/routes/auth.py) require
# HTTPS, which Render serves by default. Leaving it as "development"
# in production would let that cookie be sent over plain HTTP too.

# Production security: use a cryptographically random value of 32+ bytes.
# Example: python -c "import secrets; print(secrets.token_urlsafe(48))"
# DASHBOARD_INTERNAL_KEY must match the Raxor service's value.
