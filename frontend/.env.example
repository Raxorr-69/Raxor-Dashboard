# Base URL of the dashboard backend API (see backend/.env.example).
VITE_API_BASE_URL=http://localhost:8000

# Same Discord application id as the backend's DISCORD_CLIENT_ID — used
# client-side only to build the bot-invite link for servers that don't
# have Raxor installed yet (see components/guild/GuildCard.jsx).
VITE_DISCORD_CLIENT_ID=
